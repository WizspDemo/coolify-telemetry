# Port the agent listens on inside its container
PORT=7777

# Shared secret the dashboard must send as "Authorization: Bearer <AGENT_TOKEN>"
AGENT_TOKEN=change-me-to-a-long-random-string

# Human-readable name for this server, shown on the dashboard
SERVER_LABEL=Production VPS 1

# Base URL of the coolify-sentinel container, reachable from this agent's
# container because both are attached to the same Docker network.
# Coolify's default standalone network is called "coolify" unless you
# changed it - check with: docker network ls
SENTINEL_URL=http://coolify-sentinel:8888

# Sentinel token: Coolify UI -> Servers -> <server> -> Sentinel -> Configuration
# (Or: docker exec coolify-sentinel env | grep TOKEN on the host)
SENTINEL_TOKEN=paste-the-sentinel-token-here

# Path to the docker socket (mounted read-only in docker-compose)
DOCKER_SOCKET_PATH=/var/run/docker.sock
