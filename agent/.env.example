# Port the agent listens on inside its container
PORT=7777

# Shared secret the dashboard must send as "Authorization: Bearer ***"
AGENT_TOKEN=change-me-to-a-long-random-string

# Human-readable name for this server, shown on the dashboard
SERVER_LABEL=Production VPS 1

# Path to the docker socket (mounted read-only in docker-compose)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Read-only bind mounts of the HOST's /proc and / filesystem, used to read
# real CPU/RAM/disk numbers without SSH or Coolify's Sentinel container.
# These paths are INSIDE the container - see docker-compose.yml for the
# volume mounts that make them point at the actual host filesystem.
HOST_PROC_PATH=/hostfs/proc
HOST_ROOT_PATH=/hostfs/root
