{
  "name": "coolify-telemetry-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the Coolify telemetry dashboard: aggregates metrics from one agent per Coolify server and serves the built React frontend.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "typescript": "^5.5.3"
  }
}
