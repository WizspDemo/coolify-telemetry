# Port the dashboard backend listens on
PORT=8080

# Directory where accounts (users.json) are persisted. Mount this as a
# Coolify persistent storage volume - see docker-compose.yml - so accounts
# and their passwords survive redeploys.
DATA_DIR=/app/data

# Used ONLY to create the very first account, the very first time the app
# boots with no accounts yet. After that, log in with these and change the
# password from the UI - the env vars are never read again.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign login sessions (HMAC). Set this to a long random
# string in production - if you leave it empty, a random one is generated
# per process start, which logs everyone out on every redeploy.
SESSION_SECRET=

# JSON array describing every Coolify server's telemetry agent.
# name        - shown in the UI
# url         - base URL of that server's coolify-telemetry-agent
# token       - the AGENT_TOKEN you set when deploying that agent
SERVERS=[
  {"name":"Server 1","url":"https://telemetry-1.example.com","token":"agent-token-1"},
  {"name":"Server 2","url":"https://telemetry-2.example.com","token":"agent-token-2"},
  {"name":"Server 3","url":"https://telemetry-3.example.com","token":"agent-token-3"}
]
